# PostgreSQL connection used by Prisma.
# The storefront works with seeded fallback content when this is not set,
# but /admin forms require a real database connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/golara?schema=public"

# Required before CMS writes are enabled.
# Replace these placeholder strings locally; do not commit real secrets.
ADMIN_PASSWORD="replace-this-password"
ADMIN_SESSION_SECRET="replace-this-session-secret"

# Optional identity metadata for password-gated admin sessions.
# Future provider auth can replace this seam with real user identities.
ADMIN_LABEL="Admin"
ADMIN_EMAIL=""
ADMIN_ROLE="owner"

# Production data-safety confirmations.
# Set these to true only after reviewing migration, backup/restore, and rollback procedures.
PRODUCTION_MIGRATION_RUNBOOK_CONFIRMED="false"
PRODUCTION_BACKUP_RESTORE_CONFIRMED="false"
PRODUCTION_ROLLBACK_PLAN_CONFIRMED="false"

# Media storage.
# Supported providers: local, cloudinary.
# local writes development uploads to public/uploads.
# cloudinary uses unsigned upload presets and does not require an SDK.
MEDIA_STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_UPLOAD_FOLDER="golara"

# Checkout and domestic gateway planning.
# Supported checkout modes: inquiry, assisted, gateway.
# Supported gateway providers for the initial seam: manual.
CHECKOUT_MODE="inquiry"
CHECKOUT_DOMESTIC_GATEWAY_PROVIDER="manual"
CHECKOUT_DOMESTIC_CURRENCY="TOMAN"
CHECKOUT_OVERSEAS_FALLBACK="whatsapp"

# Inquiry notification hooks.
# Supported modes: log, webhook.
# log writes a server log entry. webhook POSTs JSON to INQUIRY_NOTIFICATION_WEBHOOK_URL.
INQUIRY_NOTIFICATION_MODE="log"
INQUIRY_NOTIFICATION_EMAIL=""
INQUIRY_NOTIFICATION_WHATSAPP=""
INQUIRY_NOTIFICATION_WEBHOOK_URL=""
