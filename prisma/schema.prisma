generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String              @id @default(cuid())
  slug           String              @unique
  code           String              @unique
  title          String
  description    String
  priceCents     Int
  currency       String              @default("CAD")
  imageUrl       String
  availableToday Boolean             @default(false)
  bestSeller     Boolean             @default(false)
  requiresQuote  Boolean             @default(false)
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  images         Media[]
  inquiries      CustomerInquiry[]
  orderItems     CheckoutOrderItem[]
  cartItems      CartItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([isActive, bestSeller])
}

model Category {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  eyebrow         String
  description     String
  imageUrl        String?
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  showOnHomepage  Boolean    @default(true)
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([parentId])
  @@index([showOnHomepage, sortOrder])
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  alt       String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  subtitle  String?
  body      String?
  payload   Json
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id          String            @id @default(cuid())
  phone       String            @unique
  displayName String?
  email       String?
  locale      String            @default("fa-IR")
  accounts    CustomerAccount[]
  sessions    CustomerSession[]
  addresses   CustomerAddress[]
  orders      CheckoutOrder[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([email])
}

model CustomerAccount {
  id                 String          @id @default(cuid())
  customerId         String
  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider           String          @default("phone")
  providerAccountId  String
  email              String?
  phone              String?
  passwordHash       String?
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([provider, providerAccountId])
  @@index([customerId])
  @@index([email])
  @@index([phone])
}

model CustomerSession {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String          @unique
  provider   String          @default("customer")
  userAgent  String?
  ipHash     String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([customerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model CustomerOtpChallenge {
  id           String    @id @default(cuid())
  channel      String    @default("sms")
  destination  String
  codeHash     String
  purpose      String    @default("login")
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  expiresAt    DateTime
  consumedAt   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([destination, purpose, expiresAt])
  @@index([expiresAt, consumedAt])
}

model CustomerAuthEvent {
  id            String   @id @default(cuid())
  eventType     String
  phoneHash     String?
  ipHash        String?
  userAgentHash String?
  challengeId   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([phoneHash, eventType, createdAt])
  @@index([ipHash, eventType, createdAt])
  @@index([challengeId, eventType, createdAt])
  @@index([eventType, createdAt])
}

model CustomerAddress {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String          @default("Delivery address")
  recipient  String?
  phone      String?
  city       String?
  line1      String
  line2      String?
  notes      String?
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orders      CheckoutOrder[]

  @@index([customerId, isDefault])
}

model CartSession {
  id        String     @id @default(cuid())
  token     String     @unique
  locale    String     @default("fa-IR")
  currency  String     @default("TOMAN")
  status    String     @default("active")
  expiresAt DateTime
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, expiresAt])
}

model CartItem {
  id        String      @id @default(cuid())
  cartId    String
  cart      CartSession @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model CheckoutOrder {
  id                String                       @id @default(cuid())
  orderNumber       String                       @unique
  publicLookupToken String?                      @unique
  customerId        String?
  customer          CustomerProfile?             @relation(fields: [customerId], references: [id])
  addressId         String?
  address           CustomerAddress?             @relation(fields: [addressId], references: [id])
  status            String                       @default("draft")
  checkoutMode      String                       @default("inquiry")
  currency          String                       @default("TOMAN")
  subtotalCents     Int                          @default(0)
  deliveryCents     Int                          @default(0)
  discountCents     Int                          @default(0)
  totalCents        Int                          @default(0)
  deliveryDate      DateTime?
  deliveryWindow    String?
  fulfillmentStatus String                       @default("not_scheduled")
  fulfillmentNote   String?
  courierName       String?
  courierPhone      String?
  recipientName     String?
  recipientPhone    String?
  customerNote      String?
  staffNotes        String?
  items             CheckoutOrderItem[]
  paymentAttempts   CheckoutPaymentAttempt[]
  timelineEvents    CheckoutOrderTimelineEvent[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([customerId, createdAt])
}

model CheckoutOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  productTitle   String
  productCode    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
}

model CheckoutPaymentAttempt {
  id                String                 @id @default(cuid())
  orderId           String
  order             CheckoutOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String                 @default("manual")
  status            String                 @default("created")
  amountCents       Int
  currency          String                 @default("TOMAN")
  providerReference String?
  redirectUrl       String?
  metadata          Json?
  events            CheckoutPaymentEvent[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([orderId, createdAt])
  @@index([provider, status])
}

model CheckoutPaymentEvent {
  id               String                 @id @default(cuid())
  paymentAttemptId String
  paymentAttempt   CheckoutPaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  provider         String
  eventType        String
  idempotencyKey   String
  status           String?
  metadata         Json?
  processedAt      DateTime?
  createdAt        DateTime               @default(now())

  @@unique([provider, idempotencyKey])
  @@index([paymentAttemptId, createdAt])
  @@index([provider, eventType, createdAt])
  @@index([processedAt])
}

model CheckoutOrderTimelineEvent {
  id           String        @id @default(cuid())
  orderId      String
  order        CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type         String
  title        String
  note         String?
  actorLabel   String?
  actorRole    String?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

model CustomerInquiry {
  id            String                    @id @default(cuid())
  name          String?
  email         String?
  phone         String?
  message       String
  productId     String?
  product       Product?                  @relation(fields: [productId], references: [id])
  deliveryDate  DateTime?
  deliveryNotes String?
  staffNotes    String?
  status        String                    @default("new")
  followUps     CustomerInquiryFollowUp[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model CustomerInquiryFollowUp {
  id        String          @id @default(cuid())
  inquiryId String
  inquiry   CustomerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  note      String
  channel   String          @default("internal")
  createdAt DateTime        @default(now())

  @@index([inquiryId, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  action       String
  entity       String
  entityId     String?
  summary      String
  actorType    String   @default("password")
  actorLabel   String   @default("Admin")
  actorEmail   String?
  actorRole    String   @default("owner")
  actorProvider String  @default("password")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
  @@index([actorRole, createdAt])
}
