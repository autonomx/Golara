generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String              @id @default(cuid())
  slug           String              @unique
  code           String              @unique
  title          String
  description    String
  priceCents     Int
  currency       String              @default("CAD")
  imageUrl       String
  availableToday Boolean             @default(false)
  bestSeller     Boolean             @default(false)
  isActive       Boolean             @default(true)
  sortOrder      Int                 @default(0)
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id])
  images         Media[]
  inquiries      CustomerInquiry[]
  orderItems     CheckoutOrderItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([categoryId])
  @@index([isActive, bestSeller])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  eyebrow     String
  description String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String   @unique
  alt       String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  subtitle  String?
  body      String?
  payload   Json
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CustomerProfile {
  id          String          @id @default(cuid())
  phone       String          @unique
  displayName String?
  email       String?
  locale      String          @default("fa-IR")
  addresses   CustomerAddress[]
  orders      CheckoutOrder[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([email])
}

model CustomerAddress {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String          @default("Delivery address")
  recipient  String?
  phone      String?
  city       String?
  line1      String
  line2      String?
  notes      String?
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orders      CheckoutOrder[]

  @@index([customerId, isDefault])
}

model CheckoutOrder {
  id                String                       @id @default(cuid())
  orderNumber       String                       @unique
  publicLookupToken String?                      @unique
  customerId        String?
  customer          CustomerProfile?             @relation(fields: [customerId], references: [id])
  addressId         String?
  address           CustomerAddress?             @relation(fields: [addressId], references: [id])
  status            String                       @default("draft")
  checkoutMode      String                       @default("inquiry")
  currency          String                       @default("TOMAN")
  subtotalCents     Int                          @default(0)
  deliveryCents     Int                          @default(0)
  discountCents     Int                          @default(0)
  totalCents        Int                          @default(0)
  deliveryDate      DateTime?
  deliveryWindow    String?
  recipientName     String?
  recipientPhone    String?
  customerNote      String?
  staffNotes        String?
  items             CheckoutOrderItem[]
  paymentAttempts   CheckoutPaymentAttempt[]
  timelineEvents    CheckoutOrderTimelineEvent[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

model CheckoutOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  productTitle   String
  productCode    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
}

model CheckoutPaymentAttempt {
  id                String        @id @default(cuid())
  orderId           String
  order             CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("manual")
  status            String        @default("created")
  amountCents       Int
  currency          String        @default("TOMAN")
  providerReference String?
  redirectUrl       String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId, createdAt])
  @@index([provider, status])
}

model CheckoutOrderTimelineEvent {
  id           String        @id @default(cuid())
  orderId      String
  order        CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type         String
  title        String
  note         String?
  actorLabel   String?
  actorRole    String?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

model CustomerInquiry {
  id            String                    @id @default(cuid())
  name          String?
  email         String?
  phone         String?
  message       String
  productId     String?
  product       Product?                  @relation(fields: [productId], references: [id])
  deliveryDate  DateTime?
  deliveryNotes String?
  staffNotes    String?
  status        String                    @default("new")
  followUps     CustomerInquiryFollowUp[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model CustomerInquiryFollowUp {
  id        String          @id @default(cuid())
  inquiryId String
  inquiry   CustomerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  note      String
  channel   String          @default("internal")
  createdAt DateTime        @default(now())

  @@index([inquiryId, createdAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  action       String
  entity       String
  entityId     String?
  summary      String
  actorType    String   @default("password")
  actorLabel   String   @default("Admin")
  actorEmail   String?
  actorRole    String   @default("owner")
  actorProvider String  @default("password")
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
  @@index([actorRole, createdAt])
}
