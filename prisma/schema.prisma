generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String               @id @default(cuid())
  slug           String               @unique
  code           String               @unique
  title          String
  description    String
  seoTitle       String?
  seoDescription String?
  canonicalPath String?
  seoIndex       Boolean              @default(true)
  priceCents     Int
  currency       String               @default("CAD")
  imageUrl       String
  availableToday Boolean              @default(false)
  bestSeller     Boolean              @default(false)
  requiresQuote  Boolean              @default(false)
  isActive       Boolean              @default(true)
  sortOrder      Int                  @default(0)
  categoryId     String
  category       Category             @relation(fields: [categoryId], references: [id])
  productTypeId  String?
  productType    ProductType?         @relation(fields: [productTypeId], references: [id])
  images         Media[]
  inquiries      CustomerInquiry[]
  orderItems     CheckoutOrderItem[]
  cartItems      CartItem[]
  translations   ProductTranslation[]
  variants       ProductVariant[]
  attributeValues ProductAttributeValue[]
  collections    ProductCollection[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([categoryId])
  @@index([productTypeId])
  @@index([isActive, bestSeller])
}

model ProductType {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model ProductAttribute {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  inputType    String   @default("text")
  appliesTo    String   @default("product")
  unit         String?
  options      Json?
  isFilterable Boolean  @default(false)
  isRequired   Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  values       ProductAttributeValue[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([appliesTo, isActive, sortOrder])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String   @unique
  name       String
  priceCents Int
  currency   String   @default("CAD")
  imageUrl   String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  attributeValues ProductAttributeValue[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, isActive])
  @@index([sku])
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([attributeId, productId])
  @@unique([attributeId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  description String?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive, sortOrder])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  description String?
  imageAlt    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, locale])
  @@index([locale, isPublished])
}

model Category {
  id              String                @id @default(cuid())
  slug            String                @unique
  title           String
  eyebrow         String
  description     String
  imageUrl        String?
  parentId        String?
  parent          Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]            @relation("CategoryHierarchy")
  showOnHomepage  Boolean               @default(true)
  sortOrder       Int                   @default(0)
  isActive        Boolean               @default(true)
  products        Product[]
  translations    CategoryTranslation[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([parentId])
  @@index([showOnHomepage, sortOrder])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  title       String
  eyebrow     String?
  description String?
  imageAlt    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([locale, isPublished])
}

model Media {
  id              String   @id @default(cuid())
  url             String   @unique
  alt             String
  sourceType      String   @default("external")
  storageProvider String?
  mimeType        String?
  sizeBytes       Int?
  metadata        Json?
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([sourceType, storageProvider])
}

model HomepageSection {
  id           String                       @id @default(cuid())
  key          String                       @unique
  title        String
  subtitle     String?
  body         String?
  payload      Json
  isActive     Boolean                      @default(true)
  sortOrder    Int                          @default(0)
  translations HomepageSectionTranslation[]
  updatedAt    DateTime                     @updatedAt
}

model HomepageSectionTranslation {
  id          String          @id @default(cuid())
  sectionId   String
  section     HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  locale      String
  title       String?
  subtitle    String?
  body        String?
  payload     Json?
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([sectionId, locale])
  @@index([locale, isPublished])
}

model CustomerProfile {
  id          String            @id @default(cuid())
  phone       String            @unique
  displayName String?
  email       String?
  locale      String            @default("fa-IR")
  accounts    CustomerAccount[]
  sessions    CustomerSession[]
  addresses   CustomerAddress[]
  orders      CheckoutOrder[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([email])
}

model CustomerAccount {
  id                 String          @id @default(cuid())
  customerId         String
  customer           CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider           String          @default("phone")
  providerAccountId  String
  email              String?
  phone              String?
  passwordHash       String?
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([provider, providerAccountId])
  @@index([customerId])
  @@index([email])
  @@index([phone])
}

model CustomerSession {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String          @unique
  provider   String          @default("customer")
  userAgent  String?
  ipHash     String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([customerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model CustomerOtpChallenge {
  id           String    @id @default(cuid())
  channel      String    @default("sms")
  destination  String
  codeHash     String
  purpose      String    @default("login")
  attemptCount Int       @default(0)
  maxAttempts  Int       @default(5)
  expiresAt    DateTime
  consumedAt   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([destination, purpose, expiresAt])
  @@index([expiresAt, consumedAt])
}

model CustomerAuthEvent {
  id            String   @id @default(cuid())
  eventType     String
  phoneHash     String?
  ipHash        String?
  userAgentHash String?
  challengeId   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([phoneHash, eventType, createdAt])
  @@index([ipHash, eventType, createdAt])
  @@index([challengeId, eventType, createdAt])
  @@index([eventType, createdAt])
}

model CustomerAddress {
  id         String          @id @default(cuid())
  customerId String
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String          @default("Delivery address")
  recipient  String?
  phone      String?
  city       String?
  line1      String
  line2      String?
  notes      String?
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orders      CheckoutOrder[]

  @@index([customerId, isDefault])
}

model CartSession {
  id        String     @id @default(cuid())
  token     String     @unique
  locale    String     @default("fa-IR")
  currency  String     @default("TOMAN")
  status    String     @default("active")
  expiresAt DateTime
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, expiresAt])
}

model CartItem {
  id        String      @id @default(cuid())
  cartId    String
  cart      CartSession @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model CheckoutOrder {
  id                   String                           @id @default(cuid())
  orderNumber          String                           @unique
  publicLookupToken    String?                          @unique
  customerId           String?
  customer             CustomerProfile?                 @relation(fields: [customerId], references: [id])
  addressId            String?
  address              CustomerAddress?                 @relation(fields: [addressId], references: [id])
  capacityReservationId String?                         @unique
  capacityReservation   FulfillmentCapacityReservation? @relation(fields: [capacityReservationId], references: [id])
  status               String                           @default("draft")
  checkoutMode         String                           @default("inquiry")
  currency             String                           @default("TOMAN")
  subtotalCents        Int                              @default(0)
  deliveryCents        Int                              @default(0)
  discountCents        Int                              @default(0)
  totalCents           Int                              @default(0)
  deliveryDate         DateTime?
  deliveryWindow       String?
  fulfillmentStatus    String                           @default("not_scheduled")
  fulfillmentNote      String?
  courierName          String?
  courierPhone         String?
  recipientName        String?
  recipientPhone       String?
  customerNote         String?
  staffNotes           String?
  items                CheckoutOrderItem[]
  paymentAttempts      CheckoutPaymentAttempt[]
  timelineEvents       CheckoutOrderTimelineEvent[]
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  @@index([status, createdAt])
  @@index([fulfillmentStatus, createdAt])
  @@index([customerId, createdAt])
  @@index([capacityReservationId])
}

model CheckoutOrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  productTitle   String
  productCode    String
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
}

model CheckoutPaymentAttempt {
  id                String                 @id @default(cuid())
  orderId           String
  order             CheckoutOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String                 @default("manual")
  status            String                 @default("created")
  amountCents       Int
  currency          String                 @default("TOMAN")
  providerReference String?
  redirectUrl       String?
  metadata          Json?
  events            CheckoutPaymentEvent[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([orderId, createdAt])
  @@index([provider, status])
}

model CheckoutPaymentEvent {
  id               String                 @id @default(cuid())
  paymentAttemptId String
  paymentAttempt   CheckoutPaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  provider         String
  eventType        String
  idempotencyKey   String
  status           String?
  metadata         Json?
  processedAt      DateTime?
  createdAt        DateTime               @default(now())

  @@unique([provider, idempotencyKey])
  @@index([paymentAttemptId, createdAt])
  @@index([provider, eventType, createdAt])
  @@index([processedAt])
}

model FulfillmentCapacityBucket {
  id              String                           @id @default(cuid())
  capacityDate    DateTime
  windowKey       String
  fulfillmentType String                           @default("delivery")
  capacity        Int
  reserved        Int                              @default(0)
  metadata        Json?
  reservations    FulfillmentCapacityReservation[]
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  @@unique([capacityDate, windowKey, fulfillmentType])
  @@index([capacityDate, fulfillmentType])
}

model FulfillmentCapacityReservation {
  id        String                    @id @default(cuid())
  bucketId  String
  bucket    FulfillmentCapacityBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  order     CheckoutOrder?
  status    String                    @default("held")
  quantity  Int                       @default(1)
  expiresAt DateTime?
  metadata  Json?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([bucketId, status])
  @@index([status, expiresAt])
}

model CheckoutOrderTimelineEvent {
  id           String        @id @default(cuid())
  orderId      String
  order        CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type         String
  title        String
  note         String?
  actorLabel   String?
  actorRole    String?
  metadata     Json?
  createdAt    DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

model CustomerInquiry {
  id                    String                    @id @default(cuid())
  name                  String?
  email                 String?
  phone                 String?
  message               String
  productId             String?
  product               Product?                  @relation(fields: [productId], references: [id])
  deliveryDate          DateTime?
  deliveryNotes         String?
  staffNotes            String?
  status                String                    @default("new")
  assignedAdminId       String?
  assignedAdminLabel    String?
  assignedAdminEmail    String?
  assignedAdminRole     String?
  assignedAt            DateTime?
  followUps             CustomerInquiryFollowUp[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([assignedAdminId, status])
  @@index([assignedAdminEmail, status])
  @@index([productId])
}

model CustomerInquiryFollowUp {
  id        String          @id @default(cuid())
  inquiryId String
  inquiry   CustomerInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  note      String
  channel   String          @default("internal")
  createdAt DateTime        @default(now())

  @@index([inquiryId, createdAt])
}

model AdminAccount {
  id                String    @id @default(cuid())
  provider          String    @default("password")
  providerAccountId String
  label             String
  email             String?
  role              String    @default("staff")
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([email])
  @@index([role, isActive])
  @@index([isActive, createdAt])
}

model AdminAuditLog {
  id            String   @id @default(cuid())
  action        String
  entity        String
  entityId      String?
  summary       String
  actorType     String   @default("password")
  actorLabel    String   @default("Admin")
  actorEmail    String?
  actorRole     String   @default("owner")
  actorProvider String   @default("password")
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([actorEmail, createdAt])
  @@index([actorRole, createdAt])
}
