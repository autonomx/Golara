{
  "name": "golara",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tools/kill-stale-next-builds.mjs",
    "build": "next build",
    "build:vercel": "node tools/vercel-build-with-preflight.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/unit/run-tests.ts",
    "test:functional": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/functional/run-tests.ts",
    "test:api": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/api/run-tests.ts",
    "test:e2e": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/e2e/run-tests.ts",
    "test:e2e:routes": "npm run smoke:routes:local",
    "test:all": "node tools/run-full-test-suite.mjs",
    "check:file-lines": "node tools/check-file-lines.mjs",
    "check:runtime": "node tools/check-runtime.mjs && npm run check:action-boundaries",
    "check:action-boundaries": "node tools/check-action-boundaries.mjs",
    "check:admin-boundaries": "node tools/check-admin-action-boundaries.mjs",
    "check:deploy-readiness": "tsx tools/check-deploy-readiness.ts",
    "smoke:routes": "node tools/smoke-routes.mjs",
    "smoke:routes:local": "node tools/run-smoke-routes-local.mjs",
    "seed:photos": "node tools/generate-seed-product-photos.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.6",
    "postcss": "^8.4.49",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
