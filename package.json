{
  "name": "golara",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tools/kill-stale-next-builds.mjs",
    "build": "next build",
    "build:vercel": "node tools/vercel-build-with-preflight.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run test:unit:security && node --require ./tests/setup/server-only-register.cjs --import tsx tests/unit/run-tests.ts",
    "test:unit:security": "npm run test:unit:security:a && npm run test:unit:security:b && npm run test:unit:security:c",
    "test:unit:security:a": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/unit/admin-login-throttle.test.ts",
    "test:unit:security:b": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/unit/admin-login-origin-boundary.test.ts",
    "test:unit:security:c": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/unit/customer-account-origin-boundary.test.ts",
    "test:functional": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/functional/run-tests.ts",
    "test:api": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/api/run-tests.ts",
    "test:nonbrowser": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/nonbrowser/run-tests.ts",
    "test:e2e": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/e2e/run-tests.ts",
    "test:e2e:api": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/e2e/api/run-tests.ts",
    "test:e2e:lifecycle": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/e2e/lifecycle/run-tests.ts",
    "test:e2e:browser": "node tools/run-playwright-api-journeys.mjs",
    "test:e2e:providers": "node --require ./tests/setup/server-only-register.cjs --import tsx tests/e2e/api/live-provider-contract-tests.ts",
    "test:e2e:routes": "npm run smoke:routes:local",
    "test:load:api": "node tools/run-k6-api-smoke.mjs public",
    "test:load:public": "node tools/run-k6-api-smoke.mjs public",
    "test:load:catalog": "node tools/run-k6-api-smoke.mjs catalog",
    "smoke:routes": "node --require ./tests/setup/server-only-register.cjs --import tsx tools/route-smoke.ts",
    "smoke:routes:local": "node --require ./tests/setup/server-only-register.cjs --import tsx tools/route-smoke.ts --local",
    "db:seed": "tsx prisma/seed.ts && tsx prisma/seed-demo-category-media.ts && tsx prisma/seed-demo-discounts.ts && tsx prisma/seed-demo-operations.ts",
    "db:seed:core": "tsx prisma/seed.ts",
    "db:seed:demo-media": "tsx prisma/seed-demo-category-media.ts",
    "db:seed:demo-discounts": "tsx prisma/seed-demo-discounts.ts",
    "db:seed:demo-operations": "tsx prisma/seed-demo-operations.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.884.0",
    "@aws-sdk/s3-request-presigner": "^3.884.0",
    "@cloudinary/url-gen": "^1.21.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "brace-expansion": "^2.0.2"
  }
}
